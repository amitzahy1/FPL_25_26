{
  "name": "fpl-draft-analytics-hub",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "FPL Draft league analytics dashboard",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:season": "node scripts/build-season-snapshot.mjs",
    "serve": "python3 -m http.server 8000",
    "proxy": "node local_proxy.js",
    "stamp": "node scripts/stamp-version.mjs",
    "lint": "eslint .",
    "check": "node scripts/check-structure.mjs",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "verify": "npm run lint && npm test && npm run check && npm run test:smoke",
    "backtest": "node scripts/backtest-value.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "puppeteer": "^23.9.0"
  }
}
